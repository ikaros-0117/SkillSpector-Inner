ENV=dev                                                         # options: dev|stg|prd

# LLM provider: openai (default) or openai_compatible.
SKILLSPECTOR_PROVIDER=

# Aggregate deadline for one complete scan workflow. Defaults to 1080 seconds
# (18 minutes); override with a positive finite value before starting the process.
# SKILLSPECTOR_MAX_WORKFLOW_SECONDS=1080

# Maximum TP4 description-behavior review batches per analyzer execution.
# Defaults to 256; set an integer from 1 to 4096 before starting the process.
# Other file, byte, finding, and workflow-time limits still apply.
# SKILLSPECTOR_TP4_MAX_BATCHES=256

# Static analysis per artifact defaults to 300 seconds, capped by the remaining
# workflow time. Set a positive finite value before starting the process.
# SKILLSPECTOR_MAX_STATIC_ANALYSIS_SECONDS_PER_ARTIFACT=300

# For SKILLSPECTOR_PROVIDER=openai.  Point OPENAI_BASE_URL at any
# OpenAI-compatible endpoint (Ollama, vLLM, another inference gateway,
# etc.); leave unset for stock api.openai.com.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Optional reasoning effort. Unset or blank preserves the endpoint default.
# gpt-6.1-sol accepts only low, medium, high, xhigh or max.
SKILLSPECTOR_REASONING_EFFORT=
# Optional language for human-readable LLM finding text. Machine-readable values
# such as rule IDs and severity values remain unchanged.
SKILLSPECTOR_OUTPUT_LANGUAGE=
# Optional sampling controls. Unset or blank preserves endpoint defaults.
# gpt-6.1-sol and some Claude gateway models reject explicit temperature.
# Static scans (--no-llm) skip provider initialization and control validation.
SKILLSPECTOR_TEMPERATURE=                                    # range: 0..1
SKILLSPECTOR_SEED=                                           # integer

# For SKILLSPECTOR_PROVIDER=openai_compatible.
SKILLSPECTOR_COMPAT_API_KEY=
SKILLSPECTOR_COMPAT_BASE_URL=
# Optional JSON object with string header names and values; may contain secrets.
# SKILLSPECTOR_COMPAT_HEADERS='{"X-Tenant-ID":"my-tenant","X-API-Key":"gateway-key"}'

# Model and logging configuration
SKILLSPECTOR_MODEL=                                             # leave empty to use the active provider's bundled default (see README); set to override (e.g. gpt-5.2)
# SKILLSPECTOR_MODEL_REGISTRY=./model_registry.yaml             # optional override; defaults to each provider's bundled YAML in src/skillspector/providers/
SKILLSPECTOR_LOG_LEVEL=WARNING                                  # options: DEBUG|INFO|WARNING|ERROR

# langchain/langsmith config (all optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_WORKSPACE=
LANGCHAIN_PROJECT=
LANGCHAIN_ENDPOINT=
